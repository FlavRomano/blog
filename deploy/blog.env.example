# Copy to /etc/blog/blog.env (root:blog, mode 0640). Never commit the real file.
BLOG_ADDR=127.0.0.1:8080
BLOG_DB_PATH=/var/lib/blog/blog.db
BLOG_UPLOADS_DIR=/var/lib/blog/uploads
BLOG_BASE_URL=https://example.com
BLOG_TIMEZONE=Europe/Rome
BLOG_TRUST_TUNNEL=true

# Generate each with: openssl rand -hex 32. Keep them stable.
BLOG_TOTP_KEY=
BLOG_IP_SALT=

# Optional
#BLOG_TURNSTILE_SITE_KEY=
#BLOG_TURNSTILE_SECRET=
#BLOG_NOTIFY_URL=
#BLOG_CF_BEACON_TOKEN=
